# Required upstream configuration
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Client authentication
AUTH_ENABLED=false
ADMIN_TOKEN=change-me
# strict (recommended) or pass_through (legacy behavior)
CLIENT_TOKEN_MODE=strict

# Optional: use a different upstream by default
UPSTREAM_DEFAULT=openai

# Keepalive is unnecessary on a VPS
KEEPALIVE_PING_ENABLED=false
